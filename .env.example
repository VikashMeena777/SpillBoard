# ─────────────────────────────────────────────────────────────
# SpillBoard environment
#
# The app runs with NO configuration at all: it falls back to an
# in-memory store and a deterministic heuristic rater. Everything
# below is optional and additive.
#
# Every variable in this file is read somewhere in the codebase.
# If you add one, wire it up or leave it out.
# ─────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────
# Canonical public URL. Used for metadataBase, OG tags, share-card
# watermarks, OAuth redirects, and the Cashfree return_url.
# Read by: src/lib/constants.ts (SITE.url)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (optional) ─────────────────────────────────────
# Without these the app uses its in-memory store. Both are required
# together; either one alone is treated as unconfigured.
# Read by: src/lib/supabase/server.ts, src/lib/supabase/client.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── AI rating (optional) ────────────────────────────────────
# Tried in order: Groq, then Gemini, then a deterministic heuristic
# engine that always succeeds. These MUST NOT be NEXT_PUBLIC_ —
# rating runs server-side in POST /api/spill.
# Read by: src/lib/ai/ai-rater.ts
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Payments: Cashfree (optional) ───────────────────────────
# Without these, POST /api/checkout returns 501 and the pricing page
# says payments are unavailable rather than faking success.
# Read by: src/app/api/checkout/route.ts
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2023-08-01
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# ─────────────────────────────────────────────────────────────
# NOT YET IMPLEMENTED — intentionally omitted
#
# The following were declared here previously but nothing in the
# codebase ever read them. They are listed as comments so the gap is
# explicit rather than looking like working configuration:
#
#   NEXT_PUBLIC_APP_NAME     – app name is a constant in src/lib/constants.ts
#   CRON_SECRET              – no cron route exists
#   SUPABASE_SERVICE_ROLE_KEY– no privileged server mutations yet
#   NVIDIA_NIM_API_KEY       – only Groq and Gemini are wired
#   CASHFREE_WEBHOOK_SECRET  – no webhook handler; subscriptions are
#                              not activated server-side yet
#   UPSTASH_REDIS_REST_*     – rate limiting is in-process
#                              (src/lib/utils/rate-limit.ts). Swap this
#                              in before running multiple instances.
#   NEXT_PUBLIC_POSTHOG_*    – no analytics integration
# ─────────────────────────────────────────────────────────────
